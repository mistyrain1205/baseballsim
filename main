<script>
function simulateMatch() {
    // --- 1. 入力値の取得 ---
    const p_balls = parseFloat(document.getElementById('p_balls').value);
    const p_bb_base = parseFloat(document.getElementById('p_bb').value) / 100;
    const p_fatigue = parseFloat(document.getElementById('p_fatigue').value) / 100;

    const b_order = parseInt(document.getElementById('b_order').value);
    const b_bb_base = parseFloat(document.getElementById('b_bb').value) / 100;
    const b_eye = parseFloat(document.getElementById('b_eye').value) / 100;

    const gb_p = parseFloat(document.getElementById('hit_gb').value);
    const fb_p = parseFloat(document.getElementById('hit_fb').value);
    const ld_p = parseFloat(document.getElementById('hit_ld').value);

    const dir_l = parseFloat(document.getElementById('dir_left').value);
    const dir_c = parseFloat(document.getElementById('dir_center').value);
    const dir_r = parseFloat(document.getElementById('dir_right').value);

    // リーグ平均の四死球率 (基準値)
    const league_bb = 0.08;

    // --- 2. 指標による四死球率の補正 ---
    // 投手：100球を超えたら球数に応じて四死球率が上昇
    let p_bb_calc = p_bb_base;
    if (p_balls > 100) {
        p_bb_calc += (p_balls - 100) * p_fatigue;
    }
    
    // 打者：打席数（順巡り）が増えるほど目が慣れて四死球率が上昇
    let b_bb_calc = b_bb_base + ((b_order - 1) * b_eye);

    // --- 3. 対数オッズ（Log-5改良版）による最終四死球確率の計算 ---
    const numerator = (p_bb_calc * b_bb_calc) / league_bb;
    const denominator = numerator + ((1 - p_bb_calc) * (1 - b_bb_calc) / (1 - league_bb));
    const final_bb_probability = numerator / denominator;

    // 画面表示用に変換
    document.getElementById('res_p_bb').innerText = (p_bb_calc * 100).toFixed(2) + "%";
    document.getElementById('res_b_bb').innerText = (b_bb_calc * 100).toFixed(2) + "%";
    document.getElementById('res_final_bb').innerText = (final_bb_probability * 100).toFixed(2) + "%";
    document.getElementById('res_final_bip').innerText = ((1 - final_bb_probability) * 100).toFixed(2) + "%";

    // --- 4. 確率に基づいたダイスロール（対決シミュレート） ---
    const random_outcome = Math.random();
    let resultText = "";

    if (random_outcome < final_bb_probability) {
        // 四死球発生
        resultText = "▶ 【四死球】 投手がフォアボール（またはデッドボール）を与えました。ランナー一塁。";
    } else {
        // フィールドに打球が飛んだ場合 (BIP)
        resultText = "▶ 【打球発生】 バットに当たり、フィールドに打球が飛びました！\n\n";

        // 打球種類の決定
        const rand_type = Math.random() * (gb_p + fb_p + ld_p);
        let type_res = "";
        if (rand_type < gb_p) {
            type_res = "ゴロ (Grounder)";
        } else if (rand_type < gb_p + fb_p) {
            type_res = "フライ (Flyball)";
        } else {
            type_res = "ライナー (Line Drive)";
        }

        // 打球方向・ポジションの決定
        const rand_dir = Math.random() * (dir_l + dir_c + dir_r);
        let dir_res = "";
        let position = "";

        if (rand_dir < dir_l) {
            dir_res = "レフト方向（左翼）";
            position = (type_res.includes("ゴロ")) ? "サード（三塁手）またはショート（遊撃手）" : "レフト（左翼手）";
        } else if (rand_dir < dir_l + dir_c) {
            dir_res = "センター方向（中堅）";
            position = (type_res.includes("ゴロ")) ? "ピッチャー（投手）またはセカンド/ショート" : "センター（中堅手）";
        } else {
            dir_res = "ライト方向（右翼）";
            position = (type_res.includes("ゴロ")) ? "ファースト（一塁手）またはセカンド（二塁手）" : "ライト（右翼手）";
        }

        resultText += `【打球種類】: ${type_res}\n`;
        resultText += `【打球方向】: ${dir_res}\n`;
        resultText += `【該当ポジション】: ${position} 付近への打球です。`;
    }

    // 結果ログの出力
    document.getElementById('simLog').innerText = resultText;
    document.getElementById('resultArea').style.display = "block";
}
</script>

</body>
