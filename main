            <tr style="background: #fff5f5; font-weight: bold;">
                <th>この対戦での四死球確率</th>
                <td id="res_final_bb" style="color: #e53e3e;">0%</td>
                <th>フィールドに飛ぶ確率</th>
                <td id="res_final_bip">0%</td>
            </tr>
